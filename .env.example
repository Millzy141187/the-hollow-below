# Optional: override the public Supabase project baked into src/config.ts.
# Copy to .env and fill in. Only the PUBLIC anon/publishable key belongs here.
# Never use a service_role / secret key in a browser game.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Alternatively leave these unset and enter the values in the in-game
# "Multiplayer setup" panel; they are stored in your browser's localStorage.
